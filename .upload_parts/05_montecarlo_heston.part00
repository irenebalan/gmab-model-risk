N_PATHS = 10000
SEED = 12345

VARIANCE_PROXY_WINDOW_DAYS = 126
VARIANCE_SAMPLING_DAYS = (
    par.REBALANCE_FREQUENCIES[
        "mensile"
    ]
)

VARIANCE_RISK_PREMIUM_LAMBDA = 0.0

INTEGRATION_MAX = 100.0
INTEGRATION_POINTS = 250
INTEGRATION_BATCH_SIZE = 500

